{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": false,
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": ["cormi.config.ts", "src", ".cormi/**/*"]
}
