{
  "name": "@cormi/preset-react",
  "description": "The builtin preset of Cormi: routes, tmp files, HTML, dev server, build, SSR, API routes, mock, proxy and generators",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "templates"
  ],
  "license": "MIT",
  "keywords": [
    "cormi",
    "preset",
    "react",
    "umi"
  ],
  "dependencies": {
    "@babel/generator": "^7.29.8",
    "@babel/parser": "^7.29.11",
    "@babel/traverse": "^7.29.10",
    "@babel/types": "^7.29.0",
    "@cormi/bundler-vite": "workspace:*",
    "@cormi/core": "workspace:*",
    "@cormi/renderer-react": "workspace:*",
    "@cormi/server": "workspace:*",
    "babel-dead-code-elimination": "^2.0.0",
    "cheerio": "^1.2.0",
    "chokidar": "^4.0.3",
    "cordis": "4.0.0-rc.12",
    "es-module-lexer": "^1.7.0",
    "esbuild": "^0.28.0",
    "express": "^5.3.0",
    "http-proxy-middleware": "^3.0.10",
    "mustache": "^4.2.0",
    "picocolors": "^1.1.1",
    "sirv": "^3.0.2",
    "tinyglobby": "^0.2.17",
    "vite": "^7.3.7"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@types/babel__generator": "^7.27.0",
    "@types/babel__traverse": "^7.20.7",
    "@types/express": "^5.0.6",
    "@types/mustache": "^4.2.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
