import { launch } from './browser.ts'
const browser = await launch()
const page = await browser.newPage()
const logs: string[] = []
page.on('console', msg => logs.push(`${msg.type()}: ${msg.text()}`))
page.on('pageerror', err => logs.push(`pageerror: ${err.message}`))
await page.goto('http://localhost:4399/about')
await page.waitForSelector('#loader')
await page.waitForFunction(() => document.querySelector('#loader')?.textContent?.includes('served'))
console.log('about:', await page.textContent('#loader'), '| title:', await page.title())
await page.click('text=Users')
await page.waitForSelector('#users li')
console.log('users:', await page.$$eval('#users li', els => els.map(e => e.textContent)))
await page.click('text=Bob')
await page.waitForSelector('#user')
console.log('user:', await page.textContent('#user'), page.url())
await page.click('text=Home')
await page.click('button')
console.log('home:', await page.textContent('#title'), await page.textContent('button'))
console.log('logs:', logs)
await browser.close()
