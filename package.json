{
  "name": "cormi-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.6.3",
  "engines": { "node": ">=22.14.0" },
  "scripts": {
    "cormi": "node packages/cormi/dist/cli.js",
    "build": "tsc -b",
    "typecheck": "tsc -b && tsc -p tests/tsconfig.json --noEmit",
    "test": "pnpm build && node --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "demo": "pnpm build && node examples/p0/run.mjs",
    "check": "pnpm typecheck && pnpm test"
  },
  "pnpm": {
    "patchedDependencies": {
      "cordis@4.0.0-rc.11": "patches/cordis@4.0.0-rc.11.patch"
    }
  },
  "devDependencies": {
    "cormijs": "workspace:*",
    "@cormijs/core": "workspace:*",
    "@cormijs/builder": "workspace:*",
    "@cormijs/plugin-web": "workspace:*",
    "@cormijs/plugin-vite": "workspace:*",
    "@types/node": "22.13.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
