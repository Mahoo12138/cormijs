{
  "name": "cormi-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.6.3",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "cormi": "node packages/cormi/dist/cli.js",
    "create:app": "pnpm build && node packages/create/dist/cli.js",
    "build": "tsc -b",
    "typecheck": "tsc -b && tsc -p tests/tsconfig.json --noEmit",
    "test": "pnpm build && node --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:browser": "pnpm build && node --import tsx --test --test-concurrency=1 tests/browser/*.test.ts",
    "typecheck:example": "tsc -p examples/basic/tsconfig.json",
    "demo": "pnpm build && node examples/p0/run.mjs",
    "pack:local": "pnpm build && node --import tsx scripts/pack-local.ts",
    "test:package": "pnpm build && node --import tsx scripts/test-package.ts",
    "test:plugin": "pnpm build && node --import tsx scripts/test-plugin-author.ts",
    "test:application": "pnpm build && node --import tsx scripts/test-application.ts",
    "test:reliability": "pnpm build && node --expose-gc --import tsx scripts/test-reliability.ts",
    "test:linux": "node --import tsx scripts/test-linux.ts",
    "test:windows": "node --import tsx scripts/test-windows.ts",
    "check": "pnpm typecheck && pnpm test"
  },
  "pnpm": {
    "patchedDependencies": {
      "cordis@4.0.0-rc.11": "patches/cordis@4.0.0-rc.11.patch"
    }
  },
  "devDependencies": {
    "@ant-design/pro-layout": "7.22.7",
    "@cormijs/builder": "workspace:*",
    "@cormijs/core": "workspace:*",
    "@cormijs/create": "workspace:*",
    "@cormijs/plugin-antd": "workspace:*",
    "@cormijs/plugin-dev-api": "workspace:*",
    "@cormijs/plugin-react": "workspace:*",
    "@cormijs/plugin-react-vite": "workspace:*",
    "@cormijs/plugin-typescript": "workspace:*",
    "@cormijs/plugin-vite": "workspace:*",
    "@cormijs/plugin-web": "workspace:*",
    "@cormijs/preset-react-vite": "workspace:*",
    "@cormijs/routes": "workspace:*",
    "@cormijs/runtime": "workspace:*",
    "@types/node": "22.13.10",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "antd": "6.6.7",
    "cormijs": "workspace:*",
    "dayjs": "1.11.23",
    "playwright-core": "1.58.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "7.18.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
